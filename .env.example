# Copy to .env.local and fill in. Never commit .env.local.

# Public (sent to the browser)
NEXT_PUBLIC_SITE_URL=https://cavaleirosdafrancesinha.com
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CARTO_API_KEY=
# Cloudflare Turnstile site key (contact form bot check)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server only
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Browser key restricted to your domains; loaded only on admin restaurant pages
GOOGLE_MAPS_API_KEY=
TURNSTILE_SECRET_KEY=

# Email (Resend, domain cavaleirosdafrancesinha.com)
RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=
CONTACT_FORM_FROM_EMAIL=no-reply@cavaleirosdafrancesinha.com
REVIEW_EMAIL_FROM=no-reply@cavaleirosdafrancesinha.com

# Playwright (tests run against the live database: keep mutations off)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
E2E_ALLOW_MUTATIONS=false
